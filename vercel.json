{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/morning-digest",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/morning-digest",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/morning-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/morning-digest",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/morning-digest",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/morning-digest",
      "schedule": "0 16 * * *"
    }
  ]
}
